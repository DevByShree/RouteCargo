PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/routecargo
DEFAULT_PHONE_COUNTRY_CODE=91

# Set this to a cryptographically random value of at least 32 bytes.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API with cookies.
CLIENT_ORIGINS=http://localhost:5173

# Defaults: 15 minute access token, 30 day refresh token (maximum 90 days), SameSite=Lax.
# Use SameSite=None only when the deployed frontend is cross-site and HTTPS is enabled.
REFRESH_TOKEN_DAYS=30
COOKIE_SAME_SITE=lax
