# Optional OSM-compatible tile provider. The default is OpenStreetMap's standard raster tiles.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Configure hosted or self-hosted providers for production. Development falls back to
# Photon for geocoding and the OSRM demo server for routing when these are blank.
VITE_GEOCODING_BASE_URL=
VITE_ROUTING_BASE_URL=
